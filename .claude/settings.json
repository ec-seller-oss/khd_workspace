{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kikuchikenta/01_honbu_docs_automation/scripts/khd_git_sync.sh pull",
            "timeout": 90,
            "statusMessage": "金庫から最新を取得中 (git pull)..."
          },
          {
            "type": "command",
            "command": "bash /Users/kikuchikenta/01_honbu_docs_automation/scripts/khd_status_board.sh",
            "timeout": 15,
            "statusMessage": "現在地ボードを表示中..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/kpi_hook.py\" --mode session",
            "timeout": 20,
            "statusMessage": "KPIの変動と未消化の次アクションを集計中..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kikuchikenta/01_honbu_docs_automation/scripts/khd_git_sync.sh push",
            "timeout": 90,
            "statusMessage": "金庫へ保存中 (git push)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kikuchikenta/01_honbu_docs_automation/scripts/khd_notion_log_reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/kpi_hook.py\" --mode prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/kpi_hook.py\" --mode stop",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
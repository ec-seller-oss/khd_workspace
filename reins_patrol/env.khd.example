# KHD版 reins-patrol 設定（~/reins-patrol/.env に置く）
# ⚠️ このファイル自体には実IDを書かない。リポジトリにはexampleのみ置く。

REINS_USER_ID=（自分がログイン権限を持つ業者ID）
REINS_PASSWORD=（そのパスワード）

# REINS側で先に「保存済み検索」を作り、その表示名を正確に書く。
# 候補（現行案件から。1つの.envで1検索＝案件別に検索を切り替えて運用）:
#   KHD01:横浜線・田都 貸店舗事務所165㎡↑EV（内科・福井案件）
#   KHD02:旭区瀬谷区 売事業用 空家 延198㎡↑（三ツ境NPO）
#   KHD03:墨田区 戸建 3LDK 〜6500万（新さんH032）
SAVED_SEARCH_LABEL=KHD01:横浜線・田都 貸店舗事務所165㎡↑EV

# メール通知(不要なら空のまま=スキップされる)
NOTIFY_EMAIL=k.kenta0917@gmail.com
# 送信手段は伊東さんの私物CLIではなく自前が必要。未設定ならスキップ。
GMAIL_SENDER_BIN=
GMAIL_SENDER_ACCOUNT=

# pdftoppm の場所を固定したい場合のみ(通常はPATHから自動解決)
# PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm
